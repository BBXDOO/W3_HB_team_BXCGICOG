{
  "name": "LRC2",
  "display_name": "LRC2 — Lifecycle Review & Continuity Checkpoint",
  "version": "1.2.0-linec",
  "owner": "LRC2",
  "authority": "BBX19",
  "class": "review_continuity_gate",
  "tier": "L2",
  "role": "Lifecycle / Review / Continuity",
  "status": "active",
  "scope": "lifecycle_review",
  "identity": {
    "stable_id": "LRC2",
    "line_c_profile": "adaptive_runtime",
    "legacy_owner_alias": "The_Singularity_Engine"
  },
  "workspace": {
    "root": "modules/LRC2/",
    "requests": "modules/requests/",
    "reports": "modules/LRC2/reports/",
    "logs": "modules/LRC2/logs/"
  },
  "runtime": {
    "mode": "adaptive",
    "execution_style": "checkpoint_first",
    "compatibility": ["mpcp", "w3lgu", "iget"],
    "agent_cli": {
      "enabled": true,
      "mode": "adaptive",
      "log_level": "critical",
      "auto_start": true
    }
  },
  "properties": {
    "checkpoint_depth": "phase2",
    "continuity_guard": true,
    "backward_compatible": true
  },
  "input": [
    "modules/requests/",
    "docs/",
    "knowledge/",
    "core/"
  ],
  "output": [
    "modules/LRC2/"
  ]
}
