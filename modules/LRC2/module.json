{
  "name": "LRC2",
  "display_name": "LRC2 — Lifecycle Review & Continuity Checkpoint",
  "version": "1.3.0-process-layer",
  "owner": "LRC2",
  "authority": "BBX19",
  "class": "review_continuity_gate",
  "tier": "L2",
  "role": "Lifecycle / Review / Continuity",
  "status": "active",
  "scope": "lifecycle_review",
  "identity": {
    "stable_id": "LRC2",
    "line_c_profile": "adaptive_runtime",
    "legacy_owner_alias": "The_Singularity_Engine"
  },
  "workspace": {
    "root": "modules/LRC2/",
    "requests": "modules/LRC2/requests/",
    "reports": "modules/LRC2/reports/",
    "logs": "modules/LRC2/logs/",
    "memory": "modules/LRC2/memory/"
  },
  "runtime": {
    "mode": "adaptive",
    "execution_style": "checkpoint_first",
    "compatibility": [
      "mpcp",
      "w3lgu",
      "iget"
    ],
    "agent_cli": {
      "enabled": true,
      "mode": "adaptive",
      "log_level": "critical",
      "auto_start": true
    }
  },
  "properties": {
    "checkpoint_depth": "phase2",
    "continuity_guard": true,
    "backward_compatible": true,
    "process_layer_enabled": true,
    "mutation_authority": false,
    "memory_preview_only_by_default": true
  },
  "input": [
    "modules/LRC2/requests/",
    "modules/requests/",
    "docs/",
    "knowledge/",
    "core/",
    "config/"
  ],
  "output": [
    "modules/LRC2/memory/",
    "modules/LRC2/reports/",
    "modules/LRC2/logs/"
  ]
}
