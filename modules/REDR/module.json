{
  "name": "REDR",
  "display_name": "REDR — Risk Escalation & Decision Router",
  "version": "1.1.0",
  "class": "risk_decision_router",
  "tier": "L2",
  "role": "risk traceability + escalation routing",
  "status": "active",
  "owner": "REDR",
  "scope": "risk_escalation",
  "identity": {
    "stable_id": "REDR",
    "line_c_profile": "adaptive_runtime"
  },
  "workspace": {
    "root": "modules/REDR/",
    "requests": "modules/requests/",
    "reports": "modules/REDR/reports/",
    "logs": "modules/REDR/logs/"
  },
  "runtime": {
    "mode": "adaptive",
    "execution_style": "escalation_first",
    "compatibility": ["mpcp", "w3lgu", "iget"]
  },
  "input": [
    "modules/requests/",
    "docs/",
    "knowledge/",
    "core/"
  ],
  "output": [
    "modules/REDR/"
  ]
}
