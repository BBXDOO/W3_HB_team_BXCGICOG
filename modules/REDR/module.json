{
  "name": "REDR",
  "display_name": "REDR — Risk Escalation & Decision Router",
  "version": "1.3.0-process-layer",
  "owner": "REDR",
  "authority": "BBX19",
  "class": "risk_decision_router",
  "tier": "L2",
  "role": "Risk / Escalation / Routing",
  "status": "active",
  "scope": "risk_escalation",
  "identity": {
    "stable_id": "REDR",
    "line_c_profile": "adaptive_runtime",
    "legacy_owner_alias": "The_Singularity_Engine"
  },
  "workspace": {
    "root": "modules/REDR/",
    "requests": "modules/REDR/requests/",
    "reports": "modules/REDR/reports/",
    "logs": "modules/REDR/logs/",
    "packages": "modules/REDR/packages/"
  },
  "runtime": {
    "mode": "adaptive",
    "execution_style": "escalation_first",
    "compatibility": [
      "mpcp",
      "w3lgu",
      "iget"
