{
  "name": "REDR",
  "display_name": "REDR — Risk Escalation & Decision Router",
  "version": "1.2.0-linec",
  "owner": "REDR",
  "authority": "BBX19",
  "class": "risk_decision_router",
  "tier": "L2",
  "role": "Risk / Escalation / Routing",
  "status": "active",
  "scope": "risk_escalation",
  "identity": {
    "stable_id": "REDR",
    "line_c_profile": "adaptive_runtime",
    "legacy_owner_alias": "The_Singularity_Engine"
  },
  "workspace": {
    "root": "modules/REDR/",
    "requests": "modules/requests/",
    "reports": "modules/REDR/reports/",
    "logs": "modules/REDR/logs/"
  },
  "runtime": {
    "mode": "adaptive",
    "execution_style": "escalation_first",
    "compatibility": ["mpcp", "w3lgu", "iget"],
    "agent_cli": {
      "enabled": true,
      "mode": "adaptive",
      "log_level": "critical",
      "auto_start": true
    }
  },
  "properties": {
    "risk_bands": ["green", "yellow", "red"],
    "escalation_guard": true,
    "backward_compatible": true
  },
  "input": [
    "modules/requests/",
    "docs/",
    "knowledge/",
    "core/"
  ],
  "output": [
    "modules/REDR/"
  ]
}
