    "agent_cli": {
      "enabled": true,
      "mode": "adaptive",
      "log_level": "critical",
      "auto_start": true
    }
  },
  "properties": {
    "risk_bands": [
      "green",
      "yellow",
      "red"
    ],
    "escalation_guard": true,
    "backward_compatible": true,
    "process_layer_enabled": true,
    "mutation_authority": false
  },
  "input": [
    "modules/REDR/requests/",
    "modules/requests/",
    "docs/",
    "knowledge/",
    "core/",
    "config/"
  ],
  "output": [
    "modules/REDR/packages/",
    "modules/REDR/reports/",
    "modules/REDR/logs/"
  ]
