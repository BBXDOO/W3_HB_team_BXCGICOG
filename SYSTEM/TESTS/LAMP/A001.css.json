/* ==========================================================
   █▓▒░ Adaptive Semantic Luminance
        for Low-Brightness Typography ░▒▓█
   ========================================================== */

:root {

    --system-name:
        "Adaptive Semantic Luminance";

    --subtitle:
        "ระบบการเรืองแสงเชิงบริบทสำหรับอักขระในสภาพแสงต่ำ";

    --research-domain: {

        "primary":
            "Perceptual Rendering",

        "secondary":
            "Typography Engineering",

        "support":
            "Human Visual Perception",

        "accessibility":
            "Accessibility Computing"
    };

    --core-principle:
        "Allocate luminance to semantic importance instead of global display brightness.";

    --visual-style:
        "semantic-luminance";

    --rendering-mode:
        "adaptive";
}


/* ==========================================================
   ABSTRACT
   ========================================================== */

.abstract {

    "concept":
        "Adaptive Semantic Luminance";

    "description":
        "ระบบการแสดงผลตัวอักษรที่เพิ่มความสามารถในการรับรู้ข้อมูลภายใต้สภาพแสงต่ำ";

    "information-perception":
        enhanced;

    "display-luminance":
        preserved;

    "rendering-methods": [

        "Localized Glyph Illumination",

        "Semantic Priority Layer",

        "Perceptual Rendering",

        "Adaptive Contrast Enhancement",

        "Contextual Luminance Allocation"
    ];

    "enhanced-elements": [

        "พยัญชนะ",

        "สระ",

        "วรรณยุกต์",

        "keyword",

        "syntax",

        "warning information"
    ];

    "research-goals": {

        "readability":
            "improved",

        "visual-fatigue":
            "reduced",

        "recognition-accuracy":
            "enhanced",

        "accessibility":
            "supported",

        "code-reading":
            "optimized"
    };
}


/* ==========================================================
   1. RESEARCH FOUNDATION
   ========================================================== */

.research-foundation {

    "domain":
        "Human Visual Perception";

    "human-response": [

        "edge contrast",

        "local luminance difference",

        "spectral separation",

        "motion-adaptive attention"
    ];

    "observation":
        "มนุษย์ตอบสนองต่อ edge contrast ได้ดีกว่าการเพิ่ม brightness แบบ uniform illumination";

    "low-brightness-effects": [

        "fine stroke ของ glyph สูญเสีย contrast",

        "tonal mark merge กับ background",

        "recognition latency เพิ่มขึ้น",

        "eye accommodation ทำงานหนักขึ้น"
    ];

    "thai-typography-problems": [

        "stacked vowel system",

        "tonal marks",

        "multi-layer glyph composition",

        "vertical overlap density"
    ];

    "research-conclusion":
        "localized edge luminance อาจให้ perceptual efficiency สูงกว่า global brightness";
}


/* ==========================================================
   2. CORE TECHNICAL PRINCIPLE
   ========================================================== */

.core-technical-principle {

    "statement":
        "Allocate luminance to semantic importance instead of global display brightness.";

    "background":
        dimmed;

    "semantic-priority":
        enabled;

    "luminous-enhancement": [

        "edge glow",

        "spectral edge separation",

        "adaptive contrast",

        "semantic illumination weighting"
    ];
}


/* ==========================================================
   3. RENDERING ARCHITECTURE
   ========================================================== */

.rendering-architecture {

    "BackgroundAttenuationLayer": {

        "purpose": [

            "power consumption",

            "dark-environment adaptation",

            "visual noise reduction"
        ]
    };

    "GlyphExtractionLayer": {

        "analysis": [

            "glyph contour",

            "stroke density",

            "tonal region",

            "vowel overlap region"
        ]
    };

    "EdgeIlluminationLayer": {

        "techniques": [

            "signed distance field rendering",

            "bloom attenuation",

            "gaussian glow sampling",

            "subpixel edge enhancement"
        ]
    };

    "SemanticPriorityLayer": {

        "Error":
            "High",

        "Active Variable":
            "Medium",

        "Comment":
            "Low",

        "Warning":
            "High",

        "Keyword":
            "Medium"
    };

    "AdaptivePerceptionLayer": {

        "adaptive-control": [

            "glow radius",

            "spectral color",

            "contrast gain",

            "luminance threshold"
        ];

        "adaptive-context": [

            "ambient brightness",

            "font scale",

            "viewing distance",

            "reading context"
        ]
    };
}


/* ==========================================================
   4. PERCEPTUAL VISIBILITY MODEL
   ========================================================== */

.visibility-model {

    "equation":
        "Vp = (Ce * Lg * Sw) - Vn";

    "variables": {

        "Vp":
            "Perceived Visibility",

        "Ce":
            "Edge Contrast",

        "Lg":
            "Glyph Luminance",

        "Sw":
            "Semantic Weight",

        "Vn":
            "Visual Noise"
    };

    "purpose":
        "ประเมิน perception efficiency ของ localized luminance";
}


/* ==========================================================
   5. EXPERIMENTAL OBJECTIVES
   ========================================================== */

.experimental-objectives {

    "Objective-1":
        "localized glow readability evaluation";

    "Objective-2":
        "Thai recognition accuracy measurement";

    "Objective-3":
        "visual fatigue comparison";

    "Objective-4":
        "semantic illumination for code comprehension";
}


/* ==========================================================
   6. EXPERIMENTAL DESIGN
   ========================================================== */

.experimental-design {

    "test-environment": {

        "brightness":
            "<20%",

        "ambient-room":
            "dark",

        "font-size":
            "identical",

        "content-density":
            "controlled"
    };

    "display-types": [

        "OLED",

        "IPS",

        "mobile display",

        "desktop monitor"
    ];

    "test-groups": {

        "A":
            "Standard Typography",

        "B":
            "Static Glow Typography",

        "C":
            "Adaptive Semantic Luminance"
    };

    "measurement-metrics": [

        "reading speed",

        "recognition accuracy",

        "fixation duration",

        "response latency",

        "eye fatigue score"
    ];
}


/* ==========================================================
   7. TECHNICAL PROTOTYPE
   ========================================================== */

.technical-prototype {

    "platforms": {

        "Web Prototype":
            "WebGL / Canvas2D",

        "Desktop":
            "OpenGL / Vulkan",

        "Mobile":
            "Metal / Skia",

        "IDE Integration":
            "VSCode Extension"
    };
}


/* ==========================================================
   8. EXPECTED TECHNICAL CONTRIBUTIONS
   ========================================================== */

.expected-technical-contributions {

    "contributions": [

        "perceptual typography rendering",

        "semantic luminance allocation",

        "adaptive readability systems",

        "low-light interface engineering",

        "accessibility-oriented rendering"
    ];
}


/* ==========================================================
   9. RESEARCH CONSTRAINTS
   ========================================================== */

.research-constraints {

    "technical-constraints": [

        "glow oversaturation",

        "glyph blur accumulation",

        "OLED blooming artifact",

        "color fringing",

        "perceptual adaptation bias"
    ];

    "environmental-constraints": [

        "ความแตกต่างของสายตาผู้ใช้",

        "ความหนา font",

        "pixel density ของจอ"
    ];
}


/* ==========================================================
   10. RESEARCH SIGNIFICANCE
   ========================================================== */

.research-significance {

    "transition":

        "Display-Centric Illumination -> Perception-Centric Information Rendering";

    "core-shift":
        "perceptual saliency enhancement";
}


/* ==========================================================
   11. POTENTIAL APPLICATIONS
   ========================================================== */

.potential-applications {

    "systems": [

        "Accessibility Interface",

        "Low-Light IDE",

        "Tactical HUD",

        "Medical Dashboard",

        "Cognitive Display System",

        "Spatial Computing Interface",

        "Adaptive Information Visualization"
    ];
}


/* ==========================================================
   12. CONCLUSION
   ========================================================== */

.conclusion {

    "summary":
        "Adaptive Semantic Luminance ใช้ perceptual engineering เพื่อเพิ่มความสามารถในการรับรู้ข้อมูลในสภาพแสงต่ำ";

    "integrated-fields": [

        "typography engineering",

        "perceptual rendering",

        "contextual computing",

        "accessibility science"
    ];

    "future-direction": [

        "intelligent rendering systems",

        "adaptive typography frameworks",

        "perception-aware interfaces",

        "next-generation HCI systems"
    ];
}
