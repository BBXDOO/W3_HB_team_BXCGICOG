{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/BBXDOO/W3_HB_team_BXCGICOG/refactor/v0.2/workflows/orchestration_task.schema.json",
  "title": "W3 Orchestration Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "type", "priority", "origin", "payload", "created_at", "updated_at", "status", "history", "evidence", "route", "support", "mutated", "human_review_required"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^W3-ORC-[0-9]+-[0-9]+$"},
    "type": {"enum": ["REQUEST", "REPORT", "ISSUE", "SIGNAL", "INTERNAL"]},
    "priority": {"enum": ["CRITICAL", "HIGH", "NORMAL", "LOW"]},
    "origin": {"allOf": [{"$ref": "#/$defs/location"}, {"required": ["tier"]}]},
    "destination": {"oneOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]},
    "source_id": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["RECEIVED", "INSPECTING", "QUEUED", "ROUTED", "ACKNOWLEDGED", "IN_PROGRESS", "BLOCKED", "ASSISTING", "RETURNED", "VERIFYING", "WAITING_HUMAN", "COMPLETED", "REJECTED", "CANCELLED", "FAILED"]},
    "route": {"type": "array", "items": {"type": "object"}},
    "history": {"type": "array", "items": {"type": "object", "required": ["at", "event", "actor", "detail"]}},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["at", "actor", "ref"]}},
    "blocker": {"type": ["object", "null"]},
    "support": {"type": "array", "items": {"type": "object", "required": ["kind", "name", "result", "at"]}},
    "human_review_required": {"type": "boolean"},
    "human_approval": {"type": ["object", "null"]},
    "mutated": {"type": "boolean"},
    "runtime_circuit": {"$ref": "#/$defs/runtime_circuit"}
  },
  "$defs": {
    "runtime_stage": {
      "type": "object", "required": ["task", "module", "request"],
      "properties": {"task": {"type": "string"}, "module": {"type": "string"}, "request": {"type": "object"}}
    },
    "runtime_circuit": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "stages", "index", "effective_stage", "result_ref", "previous_result_ref", "verified"],
      "properties": {
        "version": {"const": 1},
        "stages": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/runtime_stage"}
        },
        "index": {"type": "integer", "minimum": 0},
        "effective_stage": {"oneOf": [{"$ref": "#/$defs/runtime_stage"}, {"type": "null"}]},
        "result_ref": {"type": ["string", "null"]},
        "previous_result_ref": {"type": ["string", "null"]},
        "verified": {"type": "boolean"},
        "review_policy": {"enum": ["each_stage", "final"]},
        "reconciliation_required": {"type": "boolean"},
        "callback_reconciliation_required": {"type": "boolean"},
        "pending_support": {
          "type": "object", "required": ["kind", "name"],
          "properties": {"kind": {"enum": ["SPECIALIST", "TOOL"]}, "name": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string"}}
        }
      }
    },
    "location": {
      "type": "object", "required": ["module"],
      "properties": {
        "module": {"type": "string", "minLength": 1},
        "tier": {"type": "integer", "minimum": 0, "maximum": 7},
        "agent": {"type": "string"}, "path": {"type": "string"}
      }
    }
  }
}
