{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3.local/wx/registry/template_registry.schema.json",
  "title": "BOX Template Registry",
  "type": "object",
  "required": ["version", "updated_at", "templates"],
  "properties": {
    "version": {"const": "1.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["template_id", "name", "path", "version", "owner", "status", "work_type", "rytm", "px", "boundary", "deny"],
        "properties": {
          "template_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^wx/templates/"},
          "version": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "status": {"enum": ["active", "draft", "deprecated"]},
          "work_type": {"type": "string", "minLength": 1},
          "rytm": {"type": "string", "minLength": 1},
          "px": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[1-9][0-9]*,[1-9][0-9]*$"}},
          "lang": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1},
          "deny": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "external_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
