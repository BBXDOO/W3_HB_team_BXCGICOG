{
  "name": "ErrorDetection",
  "display_name": "Error Detection Module",

  "version": "1.0.0",

  "owner": "Copilot-Gm",
  "authority": "BBX19",

  "class": "monitoring_node",
  "tier": "L2",
  "role": "Error Detection / Logging",

  "status": "active",
  "scope": "monitoring",

  "description": "ตรวจจับและบันทึกข้อผิดพลาดจากทุกโมดูลในระบบ W3",

  "input": [
    "error_event"
  ],

  "output": [
    "system_log"
  ],

  "input_format": {
    "event_type": "error",
    "source_module": "string",
    "error_code": "string",
    "error_message": "string",
    "timestamp": "ISO 8601"
  },

  "output_format": {
    "status": "logged",
    "log_id": "string",
    "response_time_ms": "number",
    "verified_by": "Copilot-Gm"
  },

  "schema_reference": "core/logs/system_log.schema.json",

  "fallback_protocol": {
    "if_error_unresolved": [
      "Gemini",
      "Copilot-Gm"
    ],
    "if_source_module_unavailable": [
      "ChatGPT",
      "Grok"
    ]
  },

  "runtime": {
    "speed": "fast",
    "logic": "event_detection",
    "response_style": "structured",
    "token_efficiency": "high"
  },

  "notes": "Centralized monitoring module สำหรับตรวจจับ วิเคราะห์ และบันทึก error event ของระบบ W3"
}
